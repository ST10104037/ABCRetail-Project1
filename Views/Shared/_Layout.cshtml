<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ABC Retail — @ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="navbar">
        <div class="navbar-inner">
            <a class="brand" href="/">
                <span class="stamp-badge">ABC</span>
                ABC Retail
            </a>
            <nav class="nav-links">
                <a asp-controller="Customer" asp-action="Index">Customers</a>
                <a asp-controller="Product" asp-action="Index">Products</a>
                <a asp-controller="Order" asp-action="Index">Order Queue</a>
                <a asp-controller="LogFiles" asp-action="Index">Log Files</a>
            </nav>
        </div>
    </div>
    <div class="barcode"></div>

    <main class="container">
        <div class="page-header">
            <span class="page-eyebrow">@ViewData["Title"]</span>
        </div>
        @RenderBody()
    </main>

    <footer class="site-footer">ABC Retail &middot; Order Fulfillment Console &middot; Azure Storage Solution</footer>
</body>
</html>
