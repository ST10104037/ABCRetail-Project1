@model ProductEntity
@{ ViewData["Title"] = "Add Product"; }

<h1>Add Product</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <label>Product Name</label>
    <input asp-for="ProductName" required />

    <label>Description</label>
    <textarea asp-for="Description" rows="3"></textarea>

    <label>Price</label>
    <input asp-for="Price" type="number" step="0.01" required />

    <label>Stock Quantity</label>
    <input asp-for="StockQuantity" type="number" required />

    <label>Product Image</label>
    <input type="file" name="imageFile" accept="image/*" />

    <button type="submit">Save</button>
</form>
<a class="btn-link" asp-action="Index">Back to list</a>
